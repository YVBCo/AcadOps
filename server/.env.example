# Server Environment Variables

# Database (Supabase PostgreSQL)
# Pooled connection via Supavisor (port 6543) — for runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — for migrations
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis (Upstash free tier, or local)
REDIS_URL="redis://localhost:6379"

# JWT — MUST be at least 32 characters, use 64+ in production
JWT_SECRET="change-this-to-a-long-random-secret-at-least-64-characters-long!!"
JWT_REFRESH_SECRET="change-this-to-a-DIFFERENT-long-random-secret-at-least-64-chars!!"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS="http://localhost:3001"

# Logging
LOG_LEVEL="info"

# S3-compatible Storage (optional)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# SMTP Email Configuration
# ⚠️  NEVER commit real credentials — use environment variables in production
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Academic Operations <noreply@yourdomain.edu>"
