{
    "name": "server",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Academic Operations Platform - Backend API",
    "main": "dist/index.js",
    "scripts": {
        "dev": "node --import tsx --watch-path=./src src/index.ts",
        "build": "tsc",
        "render-build": "npx prisma generate && NODE_NO_WARNINGS=1 node scripts/migrate-production.mjs && npx tsc --project tsconfig.json",
        "prestart": "NODE_NO_WARNINGS=1 node scripts/migrate-production.mjs",
        "start": "NODE_NO_WARNINGS=1 node dist/src/index.js",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1044.0",
        "@aws-sdk/s3-request-presigner": "3.1044.0",
        "@prisma/adapter-pg": "7.4.2",
        "@prisma/client": "^7.4.2",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.19.37",
        "@types/nodemailer": "^7.0.11",
        "@types/swagger-ui-express": "4.1.8",
        "@types/pg": "8.20.0",
        "argon2": "^0.44.0",
        "bullmq": "^5.70.4",
        "compression": "^1.8.0",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.2",
        "pg": "8.20.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.4.2",
        "rate-limit-redis": "^4.2.0",
        "sharp": "0.34.5",
        "swagger-ui-express": "5.0.1",
        "typescript": "^5.9.0",
        "xss": "1.0.15",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/sharp": "0.31.1",
        "tsx": "^4.19.0",
        "vitest": "^4.0.0"
    }
}
