# ─── Database (Supabase PostgreSQL) ───────────────────────
# Pooled URL via Supavisor (port 6543) — for app runtime
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL (port 5432) — for migrations only
DIRECT_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Redis (Upstash — free tier, or local) ────────────────
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=redis://default:[PASSWORD]@[REGION].upstash.io:6379

# ─── JWT ──────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=info

# ─── SMTP (optional — emails logged to console if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Academic Ops <noreply@acadops.edu>

# ─── Brevo (recommended for cloud hosting like Railway) ───
# BREVO_API_KEY=
# BREVO_FROM=Academic Ops <noreply@yourdomain.com>

# ─── S3 Storage (optional — local filesystem if not set) ──
# When configured, all file uploads (logos, login backgrounds)
# go to S3-compatible storage instead of the local filesystem.
# Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces.
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=academic-ops-uploads

# ─── Developer Seed (optional) ────────────────────────────
# In production, set this to create the initial developer account.
# If not set in production, no developer account is auto-created.
# DEV_SEED_PASSWORD=

# ─── SMS (optional — parent absence notifications) ────────
# Enable SMS notifications to parents when students are absent
SMS_ENABLED=false
# Fast2SMS API key (get from https://www.fast2sms.com)
FAST2SMS_API_KEY=
# Sender ID (6 chars, registered with DLT)
SMS_SENDER_ID=ACADOP

# ─── Frontend URL (for email links) ──────────────────────
FRONTEND_URL=http://localhost:3000
